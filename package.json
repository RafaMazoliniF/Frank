{
  "name": "frank-app",
  "version": "1.0.0",
  "description": "Frankompiler",
  "author": "Frank",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "devDependencies": {
    "electron": "^39.1.1",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.vinicius.frankapp",
    "productName": "Frank App",
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility"
    },
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!env",
      "!env/**/*"
    ]
  }
}
